# ====================================================================
# UCust.AI Multi-Server Environment Configuration
# СЕРВЕР 2 (AI GPU NODE) <-> СЕРВЕР 1 (JAVA BACKEND CORE via WireGuard HTTP)
# ====================================================================

# --------------------------------------------------------------------
# 1. ЕДИНЫЙ КОМАНДНЫЙ ШЛЮЗ ОРКЕСТРАТОРА (СЕРВЕР 2 GPU NODE)
# --------------------------------------------------------------------
# URL для вызова Оркестратора со стороны Бэкенда (Сервер 1 -> Сервер 2)
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
AI_ORCHESTRATOR_ENDPOINT=http://11.0.0.2:8000/api/v1/orchestrator/execute
AI_TASK_ENDPOINT=http://11.0.0.2:8000/api/v1/task/execute

# Секретный токен авторизации между Сервером 1 и Сервером 2 (Header: X-Internal-Secret)
INTERNAL_API_SECRET=ucust-super-secret-service-token-2026

# --------------------------------------------------------------------
# 2. СВЯЗЬ С СЕРВЕРОМ 1 (JAVA BACKEND ASYNC HTTP PUSH / CALLBACKS)
# --------------------------------------------------------------------
# Эндпоинты основного Бэкенда на Сервере 1, куда AI автоматически пушит готовый контент
JAVA_BACKEND_CALLBACK_URL=http://11.0.0.4:8080/api/v1/ai/callback
BACKEND_COLLECTOR_CALLBACK_URL=http://11.0.0.4:8080/api/v1/collectors/sync
BACKEND_API_URL=http://11.0.0.4:8080/api/v1
ENABLE_AUTO_PUSH_TO_BACKEND=true

# Мастер-ключ для AES-256 шифрования токенов клиентов (TokenCryptoVault)
TOKEN_VAULT_SECRET=ucust-enterprise-production-vault-key-2026

# --------------------------------------------------------------------
# 2. FASTAPI NATIVE QUEUE MANAGER (GPU ОЧЕРЕДЬ И RETRY)
# --------------------------------------------------------------------
AI_QUEUE_MAX_CONCURRENCY=1
AI_QUEUE_RETRY_COUNT=3
AI_QUEUE_RETRY_DELAYS=3,10,30

# Redis для кэширования и сохранения состояния очереди генерации
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# --------------------------------------------------------------------
# 2. ЛОКАЛЬНАЯ БАЗА ДАННЫХ И ВЕКТОРНЫЙ CLEAN RAG (СЕРВЕР 2)
# --------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_smm
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_smm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
UCUST_DB_HOST=localhost
UCUST_DB_PORT=5432

# --------------------------------------------------------------------
# 3. УПРАВЛЕНИЕ МЕДИА-КЭШЕМ И ХРАНИЛИЩЕМ (СЕРВЕР 2)
# --------------------------------------------------------------------
# Хранение генераций: 30 дней, кэш парсинга сайтов: 5 часов
MEDIA_RETENTION_DAYS=30
TEMP_CACHE_RETENTION_HOURS=5
MEDIA_AUTO_ARCHIVE=true

# --------------------------------------------------------------------
# 4. НАСТРОЙКИ AI-СЕРВИСА И ГЕНЕРАЦИИ (СЕРВЕР 2 GPU)
# --------------------------------------------------------------------
UCUST_LOG_LEVEL=INFO
UCUST_APP_TITLE="UCust.AI Engine"
UCUST_APP_VERSION="2.5.0-MultiServer-WG"
SERVER_MODE=true

# ComfyUI Integration (FLUX.1-Dev / SDXL)
COMFYUI_SERVER_ADDRESS=127.0.0.1:8188
COMFYUI_OUTPUT_DIR=./output
HOST_COMFYUI_OUTPUT_DIR=./output

# Tavily Web Search API Key
TRAVITY_API_KEY=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

# --------------------------------------------------------------------
# 5. ПАРСИНГ СОЦСЕТЕЙ (TELEGRAM & VK)
# --------------------------------------------------------------------
# Telegram Parser (Telethon)
TELETHON_API_ID=37805806
TELETHON_API_HASH=3edb95f2db1a5bf4d67608d79db10bbf
TELETHON_SESSION=ucust_session
UCUST_TELETHON_CHANNEL=@testaipublisher

# Telegram Bot API Token
TELEGRAM_BOT_TOKEN=8840988455:AAFsUPjrOSvQdMpuK5c-MkQdPcVB092tPzw
UCUST_ACHIEVEMENT_CHANNEL=@testaipublisher

# Telegram Proxy Settings
TELETHON_PROXY_URL=
TELETHON_PROXY_TYPE=socks5
TELETHON_PROXY_HOST=
TELETHON_PROXY_PORT=
TELETHON_PROXY_USER=
TELETHON_PROXY_PASSWORD=

# VK Parser (vk_api)
VK_ACCESS_TOKEN=
VK_API_VERSION=5.199
UCUST_VK_GROUP_ID=

# --------------------------------------------------------------------
# 6. ВНЕШНИЕ СЕТИ И КАРТЫ (INSTAGRAM, OK, YANDEX MAPS, 2GIS)
# --------------------------------------------------------------------
OK_APPLICATION_ID=
OK_PUBLIC_KEY=
OK_SECRET_KEY=
OK_ACCESS_TOKEN=

INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

YANDEX_MAPS_API_KEY=
YANDEX_BUSINESS_OAUTH_TOKEN=
TWOGIS_API_KEY=
