# ==============================================================================
# UCust AI Production & Development Environment Configuration (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE RUNTIME & SERVICE GATEWAY
# ------------------------------------------------------------------------------
ENVIRONMENT=production                 # development | staging | production
APP_NAME=UCust_AI_Gateway
APP_VERSION=2.7.0
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR | CRITICAL
DEV_SIMULATION_MODE=false              # true for Dev/CPU testbench; false for Prod GPU (A100/H100/RTX)
ENABLE_NEURAL_MODELS=1                 # 1 = GPU/Neural weights (Saiga, Moondream, Qwen); 0 = Rule-Based fallback
PYTHONIOENCODING=utf-8

# ------------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Internal service-to-service secret (WireGuard/VPC backend header: X-Internal-Secret)
INTERNAL_API_SECRET=ucust-super-secret-service-token-2026

# Bearer Token validation secret for multi-tenant isolation
JWT_SECRET=ucust-super-secret-jwt-key-change-in-production-2026
JWT_ALGORITHM=HS256

# HMAC-SHA256 Secret for signing outgoing Webhook callbacks (X-UCust-Signature)
WEBHOOK_HMAC_SECRET=ucust-webhook-hmac-sha256-signing-secret-2026
WEBHOOK_MAX_RETRIES=4                  # Exponential backoff attempts (1s, 2s, 4s, 8s)

# ------------------------------------------------------------------------------
# 3. DATABASE & VECTOR STORAGE (PostgreSQL + pgvector / SQLite fallback)
# ------------------------------------------------------------------------------
UCUST_DB_HOST=127.0.0.1
UCUST_DB_PORT=5432
POSTGRES_DB=ucust_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ucust_secure_postgres_pass_2026
DATABASE_URL=postgresql+asyncpg://postgres:ucust_secure_postgres_pass_2026@127.0.0.1:5432/ucust_ai
# Fallback local sqlite path if postgres is offline:
# DATABASE_URL=sqlite+aiosqlite:///./ai_smm_dev.db

# ------------------------------------------------------------------------------
# 4. DISTRIBUTED MESSAGE BROKER & TASK BUS (Redis + Celery)
# ------------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://127.0.0.1:6379/0

# Celery Queues
CELERY_CPU_QUEUE=ucust_ai_queue
CELERY_GPU_QUEUE=ucust_gpu_render

# ------------------------------------------------------------------------------
# 5. COMFYUI & QWEN-IMAGE 2512 ENGINE
# ------------------------------------------------------------------------------
COMFYUI_DIR=/opt/ucust/ComfyUI
COMFYUI_HOST=127.0.0.1
COMFYUI_PORT=8188
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_WS_URL=ws://127.0.0.1:8188/ws
COMFYUI_OUTPUT_DIR=/opt/ucust/ai/output/photos
COMFYUI_AUTORESTART=true
QWEN_SAMPLING_SHIFT=3.10               # ModelSamplingAuraFlow shift for Qwen-Image 2512
QWEN_CFG_SCALE=3.5                     # Recommended CFG range 3.0-4.5
QWEN_SAMPLING_STEPS=35                 # 30-40 steps with euler / normal
VAE_TILE_SIZE=512                      # VAEDecodeTiled size to prevent OOM
VAE_TILE_OVERLAP=64

# ------------------------------------------------------------------------------
# 6. OCTOPODA MULTI-AGENT RUNTIME & DASHBOARD
# ------------------------------------------------------------------------------
OCTOPODA_BASE_URL=http://127.0.0.1:8741
OCTOPODA_API_KEY=local-dev
OCTOPODA_AGENT_ID=my-assistant
OCTOPODA_MODE=auto
OCTOPODA_DASHBOARD_PORT=7842
OCTOPODA_PROXY_PORT=7843
OCTOPODA_DB_PATH=./octopoda_memory.db

# ------------------------------------------------------------------------------
# 7. LLM & VLM NEURAL ACCELERATION
# ------------------------------------------------------------------------------
SAIGA_MODEL_PATH=models/saiga/saiga_nemo_12b.BF16.gguf
SAIGA_GPU_LAYERS=-1                    # -1 = All layers on GPU, 0 = CPU only
MOONDREAM_MODEL_PATH=models/moondream/moondream2-text-model-f16.gguf
MOONDREAM_MMPROJ_PATH=models/moondream/moondream2-mmproj-f16.gguf
MOONDREAM_GPU_LAYERS=-1

# ------------------------------------------------------------------------------
# 8. THIRD-PARTY COLLECTORS & SOCIAL BRIDGES
# ------------------------------------------------------------------------------
TRAVITY_API_KEY=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=
VK_API_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# 9. OBJECT STORAGE & MEDIA RETENTION
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=local                 # local | s3 | minio
STATIC_MEDIA_BASE_URL=http://127.0.0.1:8000/output/photos
MEDIA_RETENTION_DAYS=30
TEMP_CACHE_RETENTION_HOURS=5.0
MEDIA_AUTO_ARCHIVE=true

# ------------------------------------------------------------------------------
# 10. OBSERVABILITY & WEBHOOKS
# ------------------------------------------------------------------------------
PROMETHEUS_METRICS_ENABLED=true
PROMETHEUS_METRICS_PORT=8000
BACKEND_COLLECTOR_CALLBACK_URL=http://127.0.0.1:8080/api/v1/ai/callback
JAVA_BACKEND_CALLBACK_URL=http://127.0.0.1:8080/api/v1/ai/callback
